# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Configuration (Never exposed to client / browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for canonical links and Open Graph
NEXT_PUBLIC_SITE_URL=https://nandacaterers.vercel.app/

# Google Places API Configuration for Dynamic Customer Reviews
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
GOOGLE_PLACE_ID=ChIJ...your-google-place-id-here
